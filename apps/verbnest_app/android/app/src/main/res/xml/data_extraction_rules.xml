<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through Android's backup or device-to-device
     transfer: workspaces, history and settings stay where they were made.
     Move a workspace with a snapshot export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
